<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>plcinfo</AssemblyName>
    <RootNamespace>PlcInfo</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <Authors>Adam Fisher</Authors>
    <Description>Inspect, summarize, lint and diff PLC projects from Rockwell, Siemens, CODESYS/PLCopen and Beckhoff.</Description>
    <PackageId>plcinfo</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/adamfisher/plcinfo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adamfisher/plcinfo</RepositoryUrl>
    <PackageTags>plc;l5x;rockwell;siemens;tia-portal;codesys;plcopen;twincat;ladder-logic;diff</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>plcinfo</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlcInfo.Tests" />
  </ItemGroup>

</Project>